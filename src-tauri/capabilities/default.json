{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.cache/mercs2-modkit/**" },
        { "path": "$LOCALDATA/mercs2-modkit/**" },
        { "path": "$HOME/**" },
        { "path": "$LOCALDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$HOME/.cache/mercs2-modkit/**" },
        { "path": "$LOCALDATA/mercs2-modkit/**" },
        { "path": "$HOME/**" },
        { "path": "$LOCALDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" }
      ]
    },
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
